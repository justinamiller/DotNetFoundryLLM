    <RootNamespace>DotNetFoundryLLM.Api</RootNamespace>
    <AssemblyName>DotNetFoundryLLM.Api</AssemblyName>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
